{
  "$schema": "https://raw.githubusercontent.com/cortexkit/opencode-magic-context/master/schema.json",
  "magic_context": {
    "enabled": true,
    "models": {
      "historian": "opencode/mimo-v2.5-free",
      "dreamer": "google/gemma-4-31b-it",
      "sidekick": "opencode/mimo-v2.5-free"
    },
    "memory": {
      "enabled": true,
      "maxMemories": 200,
      "importanceThreshold": 0.6
    },
    "context": {
      "maxTokens": 16000,
      "injectionBudget": 4000,
      "recentMessages": 20
    },
    "compression": {
      "enabled": true,
      "chunkSize": 4000,
      "aggressive": true
    },
    "retrieval": {
      "maxResults": 10,
      "rerank": true
    },
    "background": {
      "historianInterval": 2,
      "dreamerInterval": 10
    }
  }
}